rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return userProfileExists() &&
        getUserRole() in ['admin', 'super_admin', 'accountant', 'warehouse_manager'] &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_banned != true &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_active == true;
    }

    function isDriver() {
      return userProfileExists() &&
        getUserRole() == 'driver' &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_banned != true &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_active == true;
    }

    function isActiveMerchant(merchantId) {
      return isSignedIn() &&
        request.auth.uid == merchantId &&
        exists(/databases/$(database)/documents/profiles/$(merchantId)) &&
        get(/databases/$(database)/documents/profiles/$(merchantId)).data.role == 'merchant' &&
        get(/databases/$(database)/documents/profiles/$(merchantId)).data.is_banned != true &&
        get(/databases/$(database)/documents/profiles/$(merchantId)).data.is_active == true;
    }

    function orderExists(orderId) {
      return orderId is string &&
        exists(/databases/$(database)/documents/orders/$(orderId));
    }

    function isOrderMerchant(orderId) {
      return orderExists(orderId) &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.merchant_id == request.auth.uid;
    }

    function isFinanciallySafeOrder(orderId) {
      return orderExists(orderId) &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.financial_safe == true;
    }

    function isAssignedOrderDriver(orderId) {
      return isDriver() &&
        orderExists(orderId) &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.driver_id == request.auth.uid;
    }

    match /profiles/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if false;
      allow update: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fcm_token',
          'token_updated_at'
        ]) &&
        request.resource.data.fcm_token is string &&
        request.resource.data.fcm_token.size() <= 4096 &&
        request.resource.data.token_updated_at is timestamp;
      allow delete: if false;

      match /retail_pricing/{productId} {
        allow read: if isActiveMerchant(userId);
        allow create, update: if isActiveMerchant(userId) &&
          request.resource.data.keys().hasOnly(['price', 'updated_at']) &&
          request.resource.data.price is number &&
          request.resource.data.price >= 0 &&
          request.resource.data.updated_at is timestamp;
        allow delete: if false;
      }
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /products/{id} {
      allow read: if isAdmin() || resource.data.public_catalog_ready == true;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.merchant_id == request.auth.uid &&
          resource.data.financial_safe == true) ||
        (isDriver() &&
          resource.data.financial_safe == true &&
          (resource.data.driver_id == request.auth.uid ||
            resource.data.status in ['pending', 'confirmed']))
      );
      allow create, update, delete: if false;
    }

    match /order_items/{itemId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        ((resource.data.merchant_id == request.auth.uid ||
          isOrderMerchant(resource.data.order_id)) &&
          isFinanciallySafeOrder(resource.data.order_id)) ||
        (isAssignedOrderDriver(resource.data.order_id) &&
          isFinanciallySafeOrder(resource.data.order_id))
      );
      allow create, update, delete: if false;
    }

    match /order_returns/{returnId} {
      allow read: if isSignedIn() &&
        (isAdmin() || resource.data.merchant_id == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /merchant_customers/{customerId} {
      allow read: if isActiveMerchant(request.auth.uid) &&
        resource.data.merchant_id == request.auth.uid;
      allow write: if false;
    }

    match /merchant_ledger_entries/{entryId} {
      allow read: if isActiveMerchant(request.auth.uid) &&
        resource.data.merchant_id == request.auth.uid;
      allow write: if false;
    }

    match /merchant_ledger_summaries/{merchantId} {
      allow read: if isActiveMerchant(merchantId);
      allow write: if false;
    }

    match /user_notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']) &&
        request.resource.data.is_read is bool;
      allow create, delete: if false;
    }

    match /broadcast_notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /stats/{statId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /otp_codes/{phone} {
      allow read, write: if false;
    }

    match /product_financials/{productId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /order_financials/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /order_item_financials/{itemId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /security_migrations/{migrationId} {
      allow read, write: if false;
    }
  }
}
